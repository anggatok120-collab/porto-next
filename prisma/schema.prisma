generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  passwordHash String
  role Role @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  content String @db.Text
  problem String? @db.Text
  solution String? @db.Text
  architecture String? @db.Text
  category String
  thumbnail String?
  images String[]
  technologies String[]
  githubUrl String?
  liveUrl String?
  featured Boolean @default(false)
  published Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id String @id @default(cuid())
  name String
  category String
  level String @default("Comfortable")
  icon String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, category])
}

model Experience {
  id String @id @default(cuid())
  position String
  company String
  organization String?
  location String?
  startDate DateTime
  endDate DateTime?
  current Boolean @default(false)
  description String @db.Text
  responsibilities String[]
  technologies String[]
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id String @id @default(cuid())
  name String
  slug String @unique
  issuer String
  issueDate DateTime
  expiryDate DateTime?
  credentialId String?
  credentialUrl String?
  image String?
  skills String[]
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String
  content String @db.Text
  coverImage String?
  category String
  tags String[]
  status ContentStatus @default(DRAFT)
  seoTitle String?
  seoDescription String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  subject String
  message String @db.Text
  status MessageStatus @default(UNREAD)
  ipHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id String @id @default("site")
  name String @default("Angga")
  role String
  bio String @db.Text
  email String
  location String @default("Indonesia")
  github String?
  linkedin String?
  instagram String?
  cvUrl String?
  profileImage String?
  seoTitle String?
  seoDescription String?
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id String @id @default(cuid())
  type String
  path String
  entityId String?
  sessionHash String?
  referrer String?
  createdAt DateTime @default(now())
  @@index([type, createdAt])
  @@index([path, createdAt])
}
